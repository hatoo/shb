{
	auto_https off
	servers {
		protocols h1 h2 h2c h3
	}
}

:80 {
	handle /bigheaders {
		header {
			X-Big-00 ""
			X-Big-01 ""
			X-Big-02 ""
			X-Big-03 ""
			X-Big-04 ""
			X-Big-05 ""
			X-Big-06 ""
			X-Big-07 ""
			X-Big-08 ""
			X-Big-09 ""
			X-Big-10 ""
			X-Big-11 ""
		}
		respond "hello, world!" 200
	}
	handle /bigbody {
		root * /conf
		rewrite * /bigbody.txt
		file_server
	}
	handle {
		respond "hello, world!" 200
	}
}

:443 {
	tls /conf/cert.pem /conf/key.pem
	handle /bigheaders {
		header {
			X-Big-00 ""
			X-Big-01 ""
			X-Big-02 ""
			X-Big-03 ""
			X-Big-04 ""
			X-Big-05 ""
			X-Big-06 ""
			X-Big-07 ""
			X-Big-08 ""
			X-Big-09 ""
			X-Big-10 ""
			X-Big-11 ""
		}
		respond "hello, world!" 200
	}
	handle /bigbody {
		root * /conf
		rewrite * /bigbody.txt
		file_server
	}
	handle {
		respond "hello, world!" 200
	}
}
